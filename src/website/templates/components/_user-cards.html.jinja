{% for user in users[::] %}
    <div class="user-card">
      <h3>{{ user.username }}</h3>
      <p class="metainfo">Created: {{ user.date_created.date() }}</p>
      <div id="user-options">
        <button id="change-passwd" class="fa-button">
            <i class="fa-solid fa-key"></i>
        </button>
        <button id="delete-user"
                class="fa-button"
                hx-delete="{{ url_for("auth.user_admin") }}/{{ user.id }}"
                hx-confirm="Are you sure you want to delete user '{{ user.username }}'?"
                hx-target="body">
            <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </div>
{% endfor %}
