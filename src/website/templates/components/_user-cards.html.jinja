{% for user in users[::] %}
    <div class="user-card">
      <h3>{{ user.username }}</h3>
      <p class="metainfo">Created: {{ user.date_created.date() }}</p>
      <div id="user-options">
        <button id="change-passwd" class="fa-button">
            <i class="fa-solid fa-key"></i>
        </button>
        <button id="delete-user" class="fa-button">
            <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </div>
{% endfor %}
